+                    session.add(row)
+        session.merge(PlantAlias(name=norm_text(name), plant_id=pid))
+        session.commit()
+    say(f"Skladniki przez Wikipedie i Wikidata (bez LLM): sprawdzono {len(todo)}, nowe rosliny {len(created)}")
+    return created
