APP_NAME=Siedziba Kwiatownika
# DATABASE_URL=sqlite:///data/siedziba.db
REQUEST_DELAY_S=2.0
# Gdzie trafiaja gotowe JSON-y dla Kwiatownika
KWIATOWNIK_EXPORT_DIR=data/export

# --- LLM: router sam wykrywa modele i uklada ranking ---
LLM_PROVIDERS=gemini,groq,ollama
GEMINI_API_KEY=
GROQ_API_KEY=
# Opcjonalnie: modele wymuszone na poczatek listy, np. groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash
LLM_MODEL_PRIORITY=
# Opcjonalnie: fragmenty nazw do pominiecia, np. preview,8b
LLM_MODEL_BLOCKLIST=
LLM_MAX_MODELS_PER_PROVIDER=5
# ile prob w jednym zapytaniu (0 = wszystkie modele z listy)
LLM_MAX_ATTEMPTS=0
# gdy wszystkie modele maja limit: ile max czekac (s) na jego odnowienie zamiast zglaszac blad
LLM_MAX_WAIT_S=90
# Po ilu chwilowych bledach (429/503) z rzedu model spada na koniec listy
LLM_DEMOTE_AFTER=3
# Limity: RPM na model, CONCURRENCY na providera
GEMINI_RPM=10
GEMINI_CONCURRENCY=3
GROQ_RPM=30
GROQ_CONCURRENCY=3

# --- Zadania w tle ---
# Ile skanow moze dzialac naraz (kolejne czekaja w kolejce)
MAX_CONCURRENT_JOBS=3
# Codzienny skan zrodel z zaznaczonym "auto" (czas lokalny; puste = wylaczone)
AUTO_SCAN_TIME=03:00
# Ile stron z przepisami pokazac LLM przy budowie scrapera
PROFILE_SAMPLES=5
# Skan etapowy stron bez profilu: 1) rozpoznanie do N przepisow i N ciekawostek (z LLM),
# 2) budowa profilu scrapera z tych probek, 3) pobieranie z profilem (bez LLM dla stron przepisow)
PHASED_SCAN=true
PROBE_RECIPES=5
PROBE_FACTS=5
# Limit stron etapu rozpoznania (gdy strona ma malo przepisow)
PROBE_MAX_PAGES=150
# "Pobierz cala strone" (widok Scrapery) - domyslny limit stron dla strony z gotowym profilem
HARVEST_MAX_PAGES=2000

# --- Odkrywanie nowych stron ---
# Lokalny SearXNG z docker compose. Przy uruchomieniu bez Dockera (uvicorn): http://localhost:8081
SEARXNG_URL=http://localhost:8081
# Opcjonalnie: klucz Brave Search API (https://brave.com/search/api/)
BRAVE_API_KEY=

# --- VPN per kraj ---
# Proxy HTTP kontenerow gluetun (docker compose --profile vpn up -d). Puste = bez VPN.
# Przyklad: COUNTRY_PROXIES=ua=http://vpn-ua:8888
COUNTRY_PROXIES=
# Dane dostawcy VPN dla gluetun (lista dostawcow: https://github.com/qdm12/gluetun-wiki)
VPN_SERVICE_PROVIDER=
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# --- Tlumaczenie i eksport do Kwiatownika ---
# Eksportuj tylko przepisy zatwierdzone w panelu (false = kazdy przetlumaczony i niepowtorzony)
EXPORT_REQUIRE_APPROVAL=true
# Ile przepisow tlumaczyc w jednym zadaniu
TRANSLATE_BATCH=20
# Nazwa pliku w Kwiatownik2/data/przepisy/
EXPORT_FILENAME=siedziba_przepisy.json

# --- Wznawianie zadan ---
# Po restarcie automatycznie ponow zadania przerwane zamknieciem aplikacji
RESUME_INTERRUPTED_JOBS=true
# Maks. liczba automatycznych ponowien tego samego zadania z rzedu
MAX_AUTO_RETRIES=3

# --- Ollama: lokalny model zapasowy (uzywany dopiero, gdy Gemini i Groq zawioda / maja limity) ---
# Adres przy uruchomieniu bez Dockera; w Dockerze nadpisywany na http://ollama:11434
OLLAMA_URL=http://localhost:11434
# Modele pobierane automatycznie przy starcie (po przecinku). qwen3:8b ~5 GB; z mocnym GPU np. gemma4:12b
OLLAMA_MODELS=qwen3:8b
OLLAMA_NUM_CTX=8192
OLLAMA_CONCURRENCY=1

# --- Profil zbierania: Kwiatownik = przepisy NIEKULINARNE (lecznicze, nalewki, barwienie, kosmetyki) ---
# Pomijaj zwykle przepisy kulinarne (ciasta, dania, zupy)
SKIP_CULINARY=true
# Pomijaj przepisy, w ktorych rosliny nie sa kluczowym skladnikiem (np. maseczka z samej glinki)
REQUIRE_KEY_PLANTS=true
# Opracowanie przepisu po tlumaczeniu w tradycyjnych systemach (LLM) + uwaga "nie jest porada medyczna"
ENRICH_RECIPES=true
# Systemy: wu_xing, kampo, ajurweda, piec_filarow, doktryna_sygnatur, humory, spagiryka, chronoterapia
ENRICH_SYSTEMS=wu_xing,kampo,doktryna_sygnatur,humory,spagiryka,chronoterapia

# --- Wiedza o roslinach (widok Rosliny): Wikipedia + strony z innych krajow -> blok "wiedza" w plikach roslin ---
# Jezyki Wikipedii w kolejnosci priorytetu i z ilu z nich czytac artykul
KNOWLEDGE_LANGUAGES=pl,en,de,uk,ru,fr,cs,lt,sk,hu,ro,bg,it,es
KNOWLEDGE_WIKI_LANGS=5
# Ile innych stron (wyszukiwarka, rozne kraje) na rosline
KNOWLEDGE_WEB_PAGES=3
# Po weryfikacji drugim modelem od razu zapisuj do plikow roslin Kwiatownika (z kopia zapasowa w data/backups)
KNOWLEDGE_AUTO_APPLY=true
# Nowa roslina dostaje plik w Kwiatowniku dopiero po tylu zweryfikowanych informacjach (w tym z Wikipedii)
KNOWLEDGE_MIN_FACTS_NEW=5
# Podglad pliku JSON "przed i po" kazdej operacji (zakladka "Na zywo"): ile ostatnich migawek trzymac (0 = wylaczone)
SNAPSHOTS_KEEP=300

# --- Tlumaczenie maszynowe bez LLM (NLLB-200 + CTranslate2) ---
# Model przygotuj raz: docker compose --profile mt run --rm nllb-init   (llm = wszystko przez LLM jak dawniej)
MT_ENGINE=nllb
# MT_MODEL_DIR ustawia docker-compose (/models/nllb-200-distilled-600M)
MT_DEVICE=cpu
MT_COMPUTE_TYPE=int8
MT_THREADS=4
MT_BEAM_SIZE=2
MT_FALLBACK_LLM=true
# Wiekszy model (lepsza jakosc, ok. 2x wolniej): NLLB_MODEL=facebook/nllb-200-distilled-1.3B
# i wtedy MT_MODEL_DIR=/models/nllb-200-distilled-1.3B
# Zdjecia roslin z Wikipedii / Wikimedia Commons (galeria "url" w plikach roslin; reczne galerie zostaja)
KNOWLEDGE_PHOTOS=true
KNOWLEDGE_MAX_PHOTOS=5

# --- Scalanie wiedzy z sieci z rozdzialami roslin (widok Rosliny -> "Scal wiedze z rozdzialami") ---
# Wiedza z sieci jest wmontowywana w istniejace rozdzialy strony rosliny (blok "scalone", reczne pola bez zmian).
KNOWLEDGE_AUTO_MERGE=true
# Modele scalania po kolei (polski Bielik w Ollamie), gdy zawioda - zwykla lista modeli (Gemini/Groq...)
# Bielik 11B Q4_K_M ~6,7 GB (GPU ~8 GB VRAM), Bielik 4.5B Q8_0 ~5,1 GB
MERGE_MODELS=ollama:SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M,ollama:SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
# Pobierz brakujace modele scalania do Ollamy przy starcie
MERGE_PULL_MODELS=true
# Limit jednego zapytania do Bielika (s) - po przekroczeniu chmura, a Bielik pomijany przez 30 min
MERGE_TIMEOUT_S=120
# Limit czasu modeli lokalnych na jedna rosline (s) - pozostale podrozdzialy scalaja modele z listy
MERGE_PLANT_BUDGET_S=600
# Kontekst Bielika przy scalaniu (krotkie prompty) - mniej pamieci, wiecej modelu w GPU
MERGE_NUM_CTX=4096
# Karta ~6 GB VRAM: Bielik 11B (7,8 GB) liczy w polowie na CPU - wtedy lepiej sam 4.5B (lub 1.5B):
# MERGE_MODELS=ollama:SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0,ollama:SpeakLeash/bielik-1.5b-v3.0-instruct:Q8_0

# --- Szukanie BRAKUJACYCH informacji (luki w schemacie rosliny) ---
# Jezyki zapytan (nazwa rosliny z Wikidata w danym jezyku + temat luki), w tym Chiny i Japonia
KNOWLEDGE_SEARCH_LANGS=en,de,ru,uk,fr,zh,ja
# Ile brakujacych podrozdzialow szukac na rosline w jednym przebiegu
KNOWLEDGE_GAP_SLOTS=4
# To samo zapytanie najwczesniej po tylu dniach
KNOWLEDGE_REQUERY_DAYS=45
# Wikipedie czytane zawsze (poza KNOWLEDGE_WIKI_LANGS), jesli jest artykul
KNOWLEDGE_ASIA_LANGS=zh,ja

# --- Agenci (/agents): Audytor wiedzy, Zleceniodawca, Planista ciaglosci ---
# Petla planisty w tle (false = agenci tylko recznie z panelu)
AGENTS_ENABLED=true
# Domyslnie: gdy kolejka stoi, planista sam zleca JEDNO zadanie (przelacznik w panelu nadpisuje to ustawienie)
AGENTS_AUTO_CONTINUE=true
# Co ile minut planista sprawdza, czy Siedziba nad czyms pracuje
AGENTS_CHECK_MINUTES=5
# Nowy audyt bazy wiedzy, gdy ostatni starszy niz tyle godzin
AGENTS_AUDIT_HOURS=24
# Ile zalecen audytu zleca jeden przebieg zleceniodawcy; ile roslin w jednym zadaniu
AGENTS_DISPATCH_MAX=3
AGENTS_PLANTS_PER_TASK=4
# Ta sama roslina + rodzaj zadania najwczesniej po tylu dniach
AGENTS_REORDER_DAYS=7
# Ocena audytu przez eksperta LLM (false = same metryki kodem)
AGENTS_EXPERT_REVIEW=true
# Po 3 nieudanych zleceniach z rzedu planista robi przerwe (minuty)
AGENTS_FAIL_PAUSE_MIN=30
# Zadanie bez znaku zycia (nowy krok, wpis w logu, zapytanie do LLM) tak dlugo = zawieszone (minuty)
AGENTS_STALL_MINUTES=30
# stop = planista zatrzymuje zawieszone zadanie; report = tylko zglasza w historii
AGENTS_STALL_ACTION=stop
# Agenci nie zlecaja nowych zadan z LLM, gdy tyle juz dziala (Gemini/Groq/Ollama sie dlawia)
AGENTS_MAX_LLM_JOBS=2

# --- Backend Kwiatownika na Render (repozytorium KwiatownikBackend, render.yaml) ---
# adres uslugi i SIEDZIBA_TOKEN z panelu Render -> Environment
BACKEND_URL=
BACKEND_TOKEN=
# co ile minut stan Siedziby + kopia licznikow strony (Render usypia po 15 min ciszy)
BACKEND_SYNC_MINUTES=5

# --- Wdrozeniowiec: publikacja danych Kwiatownika2 (commit + push; Render buduje strone sam) ---
DEPLOY_ENABLED=true
# token GitHub (fine-grained) TYLKO do repozytorium Kwiatownika2, uprawnienie Contents: Read and write
GITHUB_TOKEN=
DEPLOY_BRANCH=main
# publikuj, gdy jest tyle nowych informacji o roslinach albo tyle nowych przepisow...
DEPLOY_MIN_POINTS=30
DEPLOY_MIN_RECIPES=10
# ...albo cokolwiek nowego po tylu godzinach; najczesciej co DEPLOY_MIN_HOURS (kazda publikacja = build na Render)
DEPLOY_MAX_HOURS=48
DEPLOY_MIN_HOURS=6
